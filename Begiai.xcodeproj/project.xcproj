{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "BegiaiKit",
    },
  ],
  "files": [
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Begiai.app", "id": "5027B7F930AC935200246DA0", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/BegiaiUITests.xctest", "id": "5028A72330AC935200E1E62B", "type": "wrapper.cfbundle", "index": false },
      ],
    }, {
      "kind": "folder",
      "path": "Begiai",
      "target-membership": [
        "Begiai",
      ],
      "membership-exceptions": [
        {
          "target": "BegiaiUITests",
          "inclusions": [
            "A11yID.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "BegiaiUITests", "target-membership": [ "BegiaiUITests" ] },
  ],
  "targets": [
    {
      "name": "Begiai",
      "id": "5027B7F830AC935200246DA0",
      "product": "Products/Begiai.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "BegiaiKit",
          "product-name": "BegiaiKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "BEGIAI_SEALED_LAUNCH[config=Debug]": "YES",
        "BEGIAI_SEALED_LAUNCH[config=Release]": "NO",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/Begiai-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Bėgiai",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.navigation",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "Bėgiai shows where you are on the map. Your location stays on this iPhone and is never stored.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.begiai.Begiai",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
      },
    }, {
      "name": "BegiaiUITests",
      "id": "5028A72230AC935200E1E62B",
      "product": "Products/BegiaiUITests.xctest",
      "product-type": "bundle.ui-testing",
      "dependencies": [
        "Begiai",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.begiai.BegiaiUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TEST_TARGET_NAME": "Begiai",
      },
    },
  ],
  "build-settings": {
    "CLANG_ENABLE_MODULES": "YES",
    "CODE_SIGN_STYLE": "Automatic",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "iphoneos",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
    "SWIFT_EMIT_LOC_STRINGS": "YES",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_STRICT_CONCURRENCY": "complete",
    "SWIFT_VERSION": "6.0",
    "TARGETED_DEVICE_FAMILY": "1",
  },
}
