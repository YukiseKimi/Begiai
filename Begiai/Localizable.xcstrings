    "Welcome.Estimate.Text" : {
      "comment" : "Welcome card 1 text: why every position is an estimate.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LTG Link publishes no live positions. Bėgiai moves each train along its track from the timetable, so a late train still shows where it should be."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "LTG Link neskelbia traukinių vietos realiuoju laiku. Bėgiai veda kiekvieną traukinį jo keliu pagal tvarkaraštį, todėl vėluojantis traukinys vis tiek rodomas ten, kur turėtų būti."
          }
        }
      }
    },
    "Welcome.Estimate.Title" : {
      "comment" : "Welcome card 1 title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trains move by estimate"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Traukinių vieta – apytikslė"
          }
        }
      }
    },
    "Welcome.Follow.Text" : {
      "comment" : "Welcome card 3 text: what a tap does.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its page shows the next stop. Follow keeps it in the middle of the map. Star a line or a station to keep it at the top."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jo puslapyje matysite kitą stotį. „Sekti“ laiko traukinį žemėlapio centre. Pažymėkite liniją ar stotį žvaigždute, kad ji būtų viršuje."
          }
        }
      }
    },
    "Welcome.Follow.Title" : {
      "comment" : "Welcome card 3 title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a train to follow it"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Palieskite traukinį ir sekite jį"
          }
        }
      }
    },
    "Welcome.Marks.Text" : {
      "comment" : "Welcome card 2 text: how to read a train on the map.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each train is a pointed marker in its line's colour. Its nose points the way it goes, and, when zoomed in, it glows while the train stands at a station. Scheduled means: from the timetable."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kiekvienas traukinys – smaili jo linijos spalvos žymė. Smaigalys rodo važiavimo kryptį, o priartinus žemėlapį, kol traukinys stovi stotyje, žymė šviečia. „Pagal tvarkaraštį“ reiškia: apskaičiuota iš tvarkaraščio, ne realiuoju laiku."
          }
        }
      }
    },
    "Welcome.Marks.Title" : {
      "comment" : "Welcome card 2 title.",
      "extractionState" : "manual",
      "localizations" : {
